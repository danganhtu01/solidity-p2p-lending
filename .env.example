# Copy to .env and fill in. The real .env is git-ignored — NEVER commit secrets.
#   cp .env.example .env

# --- RPC endpoints (public defaults shown; swap for Alchemy/Infura for reliability) ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
HOODI_RPC_URL=https://ethereum-hoodi-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org
MAINNET_RPC_URL=

# --- Block explorer verification (Etherscan v2: one key works across all chains) ---
# Get a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- Deployer account ---
# PREFERRED (secure): import an encrypted keystore once, then deploy with --account deployer:
#   cast wallet import deployer --interactive
# Only for a THROWAWAY testnet wallet, you may instead use a raw key here + --private-key $PRIVATE_KEY:
PRIVATE_KEY=
